{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UserProfile",
  "description": "FreeCodeCamp JSON schema structure for user profiles",
  "type": "object",
  "properties": {
    "userId": {
      "type": "integer"
    },
    "username": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["userId", "username", "email"]
}
